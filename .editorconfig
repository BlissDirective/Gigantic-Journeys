root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Locked reference documents: editors must never reformat them.
[design/**]
trim_trailing_whitespace = false
insert_final_newline = false

[context/**]
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab
