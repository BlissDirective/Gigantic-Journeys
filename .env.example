# Gigantic Journeys — environment variable NAMES only.
#
# Values live in exactly two places: ~/projects/gigantic-journeys/.env.local on the
# Bot VM (gitignored, never leaves the VM) and GitHub Actions repository secrets.
# Never put a real value in this file. CI fails any PR that tracks a .env* file
# other than this one. The Foreman copies this file to .env.local on first setup.
#
# Production Supabase service key, Apple signing certificates, and payment
# credentials are CI-only. No Bot ever holds them (kit §0, Secrets model).

# --- Supabase (the VM only ever holds the STAGING project's keys) ---
SUPABASE_URL=PLACEHOLDER
SUPABASE_ANON_KEY=PLACEHOLDER
# Staging only. The production service-role key exists only in CI secrets.
SUPABASE_STAGING_SERVICE_ROLE_KEY=PLACEHOLDER

# --- Inngest ---
INNGEST_EVENT_KEY=PLACEHOLDER
INNGEST_SIGNING_KEY=PLACEHOLDER

# --- Reconstruction and avatar vendors (accounts need an AUTH before creation) ---
LUMA_API_KEY=PLACEHOLDER
MESHY_API_KEY=PLACEHOLDER
TRIPO_API_KEY=PLACEHOLDER

# --- Deploy and repository access ---
VERCEL_TOKEN=PLACEHOLDER
# Fine-grained PAT of the Bot machine user, scoped to this repository only (AUTH #002).
GITHUB_TOKEN=PLACEHOLDER

# --- Crash reporting (added when the account is approved) ---
CRASH_REPORTING_KEY=PLACEHOLDER
