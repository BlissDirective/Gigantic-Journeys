{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BlissDirective/Gigantic-Journeys/data/schemas/environment_spec.json",
  "title": "Gigantic Journeys environment spec v1.0.0 (proposal)",
  "description": "The playable contract for one environment (SPEC §3.4; M1-SCEN-04/05): package assets, spawn, summit, 1–3 validated routes with per-segment beats, and up to three vistas. Stored in environments.environment_spec (AUTH #034) and shipped in the package the Unity runtime loads (M1-GAME-01).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "generator",
    "capture_mode",
    "scale_multiplier",
    "assets",
    "spawn",
    "summit",
    "routes",
    "vistas",
    "generation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Semver of this schema (proposal v1.0.0; frozen only once the M1-DATA-01 AUTH is approved)."
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "environments.id (AUTH #034 table)."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,39}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "description": "Service + version that produced this document (reproducibility)."
    },
    "capture_mode": {
      "type": "string",
      "enum": [
        "room",
        "tabletop"
      ]
    },
    "scale_multiplier": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "description": "Same value as scene_graph.scale.multiplier."
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "splat": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.(ply|spz|splat|glb|json|png|webp|bin)$",
          "description": "File name relative to the environment package root (never a URL, bucket path or user id)."
        },
        "collision_mesh": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.(ply|spz|splat|glb|json|png|webp|bin)$",
          "description": "File name relative to the environment package root (never a URL, bucket path or user id)."
        },
        "scene_graph": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.(ply|spz|splat|glb|json|png|webp|bin)$",
          "description": "File name relative to the environment package root (never a URL, bucket path or user id)."
        },
        "traversal_graph": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.(ply|spz|splat|glb|json|png|webp|bin)$",
          "description": "File name relative to the environment package root (never a URL, bucket path or user id)."
        },
        "thumbnail": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.(ply|spz|splat|glb|json|png|webp|bin)$",
          "description": "File name relative to the environment package root (never a URL, bucket path or user id)."
        }
      },
      "required": [
        "collision_mesh",
        "scene_graph",
        "splat",
        "thumbnail",
        "traversal_graph"
      ]
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^node-[0-9]{1,6}$",
          "description": "Spawn node."
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "facing_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        }
      },
      "required": [
        "facing_deg",
        "node_id",
        "position"
      ]
    },
    "summit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^node-[0-9]{1,6}$",
          "description": "Plantable summit node."
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "height_A": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000,
          "description": "Summit height above the floor."
        },
        "true_peak": {
          "type": "boolean",
          "description": "False when the true peak was unreachable and the highest reachable plantable point was used."
        }
      },
      "required": [
        "height_A",
        "node_id",
        "position",
        "true_peak"
      ]
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "vistas": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/vista"
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Deterministic generation seed."
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Shaping retries used (margin never relaxed)."
        },
        "template_fallback": {
          "type": "boolean",
          "description": "True when generation fell back to the single explore route."
        },
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "margin": {
              "const": 0.85
            },
            "movement_config_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "passed": {
              "const": true
            }
          },
          "required": [
            "margin",
            "movement_config_sha256",
            "passed"
          ]
        }
      },
      "required": [
        "retries",
        "seed",
        "template_fallback",
        "validator"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generation": {
            "properties": {
              "template_fallback": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "routes": {
            "maxItems": 1,
            "items": {
              "properties": {
                "template_fallback": {
                  "const": true
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "routes": {
            "minItems": 2,
            "items": {
              "properties": {
                "template_fallback": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "description": "[x, y, z] in A units, environment-local, +y up (Unity convention)."
    },
    "unit3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "description": "Unit vector [x, y, z]."
    },
    "aabb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "$ref": "#/$defs/vec3"
        },
        "max": {
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "max",
        "min"
      ],
      "description": "Axis-aligned bounds in A units."
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^route-[0-9]{1,6}$",
          "description": "Route id (route-1 = easiest)."
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "1 = easiest within this environment (relative grading, AUTH #023 Fork 2A)."
        },
        "relative_difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "global_difficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Cross-environment difficulty score kept as metadata (AUTH #023)."
        },
        "highest_tier": {
          "type": "string",
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3"
          ]
        },
        "distinct_t2plus_verbs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "tightest_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.85,
          "description": "Largest margin_used on the route."
        },
        "total_climb_A": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "commit_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "required_tool": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "grapple",
                "pole-vault",
                "wall-run"
              ],
              "description": "Tool the route cannot be finished without (taught in an earlier beat, never beat 1)."
            },
            {
              "type": "null"
            }
          ]
        },
        "template_fallback": {
          "type": "boolean",
          "description": "The guaranteed-simple 'explore' route (introduce → resolve only)."
        },
        "par_time_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400,
          "description": "Validator-estimated completion time at the controller's speeds (leaderboard plausibility floor, M4)."
        },
        "beats": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/beat"
          },
          "description": "Per-segment beats in order. Beat 1 is always T0-only and teaches nothing (SPEC §3.4, Bible §10).",
          "allOf": [
            {
              "prefixItems": [
                {
                  "properties": {
                    "index": {
                      "const": 1
                    },
                    "role": {
                      "const": "introduce"
                    },
                    "max_tier": {
                      "const": "T0"
                    },
                    "teaches": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "required": [
        "beats",
        "commit_points",
        "distinct_t2plus_verbs",
        "global_difficulty",
        "highest_tier",
        "id",
        "par_time_s",
        "rank",
        "relative_difficulty",
        "required_tool",
        "template_fallback",
        "tightest_margin",
        "total_climb_A"
      ],
      "description": "A validated route from spawn to the summit.",
      "allOf": [
        {
          "if": {
            "properties": {
              "template_fallback": {
                "const": true
              }
            },
            "required": [
              "template_fallback"
            ]
          },
          "then": {
            "properties": {
              "beats": {
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  true,
                  {
                    "properties": {
                      "index": {
                        "const": 2
                      },
                      "role": {
                        "const": "resolve"
                      }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "beats": {
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  true,
                  {
                    "properties": {
                      "index": {
                        "const": 2
                      },
                      "role": {
                        "const": "develop"
                      }
                    }
                  },
                  {
                    "properties": {
                      "index": {
                        "const": 3
                      },
                      "role": {
                        "const": "twist"
                      }
                    }
                  },
                  {
                    "properties": {
                      "index": {
                        "const": 4
                      },
                      "role": {
                        "const": "resolve"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "role": {
          "type": "string",
          "enum": [
            "introduce",
            "develop",
            "twist",
            "resolve"
          ],
          "description": "Design Skills rule 22 beat role."
        },
        "edge_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "string",
            "pattern": "^edge-[0-9]{1,6}$",
            "description": "Traversal-graph edge, in path order."
          }
        },
        "max_tier": {
          "type": "string",
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3"
          ],
          "description": "Highest tier used in the beat."
        },
        "teaches": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "walk",
                "jog",
                "run",
                "step-up",
                "hop-over",
                "mantle",
                "standing-jump",
                "running-jump",
                "crouch",
                "sprint-jump",
                "balance-walk",
                "vault",
                "speed-vault",
                "kong-vault",
                "lazy-vault",
                "precision-jump",
                "controlled-drop",
                "hang-drop",
                "slide",
                "dive-roll",
                "ledge-shimmy",
                "climb-up",
                "rung-climb",
                "stud-climb",
                "free-climb",
                "pole-climb",
                "overhang-traverse",
                "ledge-to-ledge",
                "wall-push",
                "tic-tac",
                "wall-run",
                "grapple-swing",
                "grapple-ascend",
                "grapple-rappel",
                "pole-vault"
              ],
              "description": "The new verb this beat introduces (beat 2), or the signature/tool verb (twist)."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "edge_ids",
        "index",
        "max_tier",
        "role",
        "teaches"
      ]
    },
    "vista": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^vista-[0-9]{1,6}$",
          "description": "Vista id."
        },
        "node_id": {
          "type": "string",
          "pattern": "^node-[0-9]{1,6}$",
          "description": "Traversal-graph node the vantage sits on."
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "look_at": {
          "$ref": "#/$defs/vec3"
        },
        "access_tier": {
          "type": "string",
          "enum": [
            "T0",
            "T1"
          ],
          "description": "Vistas are rewards, not gauntlets: reachable with T0–T1 only."
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "viewshed": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "framing": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "access": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "spread": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "access",
            "framing",
            "spread",
            "viewshed"
          ]
        }
      },
      "required": [
        "access_tier",
        "id",
        "look_at",
        "node_id",
        "position",
        "scores"
      ]
    }
  }
}
