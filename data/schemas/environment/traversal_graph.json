{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BlissDirective/Gigantic-Journeys/data/schemas/traversal_graph.json",
  "title": "Gigantic Journeys traversal graph v1.0.0 (proposal)",
  "description": "Which surfaces reach which, by which verb, at what difficulty (SPEC §3.3–§3.4; M1-SCEN-03). Every edge was accepted by the deterministic validator against config/movement.json at the 85 % margin (Bible §10; M1-SCEN-05). Directed: a two-way link is two edges.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "generator",
    "movement",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Semver of this schema (proposal v1.0.0; frozen only once the M1-DATA-01 AUTH is approved)."
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "environments.id (AUTH #034 table)."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,39}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "description": "Service + version that produced this document (reproducibility)."
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the config/movement.json bytes the validator used."
        },
        "margin": {
          "const": 0.85,
          "description": "Validator margin (85 % of maximum reach/distance)."
        }
      },
      "required": [
        "config_sha256",
        "margin"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "description": "[x, y, z] in A units, environment-local, +y up (Unity convention)."
    },
    "unit3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "description": "Unit vector [x, y, z]."
    },
    "aabb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "$ref": "#/$defs/vec3"
        },
        "max": {
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "max",
        "min"
      ],
      "description": "Axis-aligned bounds in A units."
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^node-[0-9]{1,6}$",
          "description": "Stable node id."
        },
        "surface_id": {
          "type": "string",
          "pattern": "^surface-[0-9]{1,6}$",
          "description": "scene_graph surface this node stands on / hangs from."
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "kind": {
          "type": "string",
          "enum": [
            "stance",
            "hang",
            "climb",
            "anchor"
          ],
          "description": "stance = on top; hang = ledge/overhang grip; climb = on a climbable face; anchor = grapple anchor."
        },
        "plantable": {
          "type": "boolean",
          "description": "A flag can be planted here (summit candidate)."
        }
      },
      "required": [
        "id",
        "kind",
        "plantable",
        "position",
        "surface_id"
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^edge-[0-9]{1,6}$",
          "description": "Stable edge id."
        },
        "from": {
          "type": "string",
          "pattern": "^node-[0-9]{1,6}$",
          "description": "Start node."
        },
        "to": {
          "type": "string",
          "pattern": "^node-[0-9]{1,6}$",
          "description": "End node."
        },
        "verb": {
          "type": "string",
          "enum": [
            "walk",
            "jog",
            "run",
            "step-up",
            "hop-over",
            "mantle",
            "standing-jump",
            "running-jump",
            "crouch",
            "sprint-jump",
            "balance-walk",
            "vault",
            "speed-vault",
            "kong-vault",
            "lazy-vault",
            "precision-jump",
            "controlled-drop",
            "hang-drop",
            "slide",
            "dive-roll",
            "ledge-shimmy",
            "climb-up",
            "rung-climb",
            "stud-climb",
            "free-climb",
            "pole-climb",
            "overhang-traverse",
            "ledge-to-ledge",
            "wall-push",
            "tic-tac",
            "wall-run",
            "grapple-swing",
            "grapple-ascend",
            "grapple-rappel",
            "pole-vault"
          ],
          "description": "Traversal verb (Bible §3, §6; AUTH #021)."
        },
        "tier": {
          "type": "string",
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3"
          ],
          "description": "Verb-difficulty tier (SPEC §3.4); must match the verb."
        },
        "distance_A": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "description": "Horizontal distance covered."
        },
        "rise_A": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000,
          "description": "Vertical change (negative = drop)."
        },
        "margin_used": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.85,
          "description": "Fraction of the movement.json maximum this transition needs; the validator rejects anything above 0.85 (Bible §10)."
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000.0,
          "description": "Capability cost used by route scoring."
        },
        "commit": {
          "type": "boolean",
          "description": "No way back once taken (a commit point)."
        },
        "prerequisites": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_speed_A_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Entry speed required (dive minSpeed, wall-run minEntrySpeed, pole-vault minRunSpeed)."
            },
            "run_up_A": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000,
              "description": "Straight run-up length available before the take-off."
            },
            "plant_window_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "description": "Pole-vault plant window."
            },
            "wall_length_A": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000,
              "description": "Wall-run face length (≥ minWallRunA)."
            },
            "anchor_ledge_A": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Grapple anchor ledge depth (≥ anchorMinLedgeA)."
            },
            "tool": {
              "type": "string",
              "enum": [
                "grapple",
                "pole-vault"
              ],
              "description": "Traversal tool the edge needs (AUTH #021)."
            }
          },
          "required": [],
          "description": "Entry and surface prerequisites the validator checked (only those that apply)."
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "verb",
        "tier",
        "distance_A",
        "rise_A",
        "margin_used",
        "cost",
        "commit",
        "prerequisites"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verb": {
                "enum": [
                  "walk",
                  "jog",
                  "run",
                  "step-up",
                  "hop-over",
                  "mantle",
                  "standing-jump",
                  "running-jump",
                  "crouch"
                ]
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "tier": {
                "const": "T0"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "enum": [
                  "sprint-jump",
                  "balance-walk",
                  "vault",
                  "speed-vault",
                  "kong-vault",
                  "lazy-vault",
                  "precision-jump",
                  "controlled-drop",
                  "hang-drop",
                  "slide",
                  "dive-roll"
                ]
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "tier": {
                "const": "T1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "enum": [
                  "ledge-shimmy",
                  "climb-up",
                  "rung-climb",
                  "stud-climb",
                  "free-climb",
                  "pole-climb",
                  "overhang-traverse",
                  "ledge-to-ledge",
                  "wall-push",
                  "tic-tac"
                ]
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "tier": {
                "const": "T2"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "enum": [
                  "wall-run",
                  "grapple-swing",
                  "grapple-ascend",
                  "grapple-rappel",
                  "pole-vault"
                ]
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "tier": {
                "const": "T3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "enum": [
                  "grapple-swing",
                  "grapple-ascend",
                  "grapple-rappel"
                ]
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "prerequisites": {
                "required": [
                  "tool",
                  "anchor_ledge_A"
                ],
                "properties": {
                  "tool": {
                    "const": "grapple"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "pole-vault"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "prerequisites": {
                "required": [
                  "tool",
                  "min_speed_A_s",
                  "plant_window_s"
                ],
                "properties": {
                  "tool": {
                    "const": "pole-vault"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "wall-run"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "prerequisites": {
                "required": [
                  "min_speed_A_s",
                  "wall_length_A"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "dive-roll"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "prerequisites": {
                "required": [
                  "min_speed_A_s"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
