  "scale": {
    "ref_multiplier": 12,
    "mode": "inverse",
    "note": "particle size, displacement depth, dust spread and haptic strength scale by ref_multiplier/multiplier, so a tinier world's reactions stay tiny (dust motes, not clouds)"
  },
  "budget": {
    "fps_floor": 30,
    "max_concurrent_reactions": 24,
    "note": "M3 exit: Tier 0 + Tier 1 hold 30 fps; shader displacement only, no physics (Tier 2 is research, SPEC §5)"
