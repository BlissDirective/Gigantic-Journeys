# api/ environment variable NAMES only — never real values.
# Values live only in the Operator VM's .env.local (staging) and CI secrets;
# CI fails any PR that tracks a .env* file other than this one (SECURITY_CHECKLIST §1).
INNGEST_EVENT_KEY=PLACEHOLDER
INNGEST_SIGNING_KEY=PLACEHOLDER
SUPABASE_URL=PLACEHOLDER
SUPABASE_ANON_KEY=PLACEHOLDER
# Service role: used by the pipeline (Inngest) to write environment assets +
# rows, bypassing RLS server-side. CI/VM only, never the repo. When both this and
# MODAL_RECONSTRUCT_URL are set, the pipeline uses the real Supabase + Modal
# adapters; otherwise it falls back to in-memory fakes (deps.ts).
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER
# Optional: private storage bucket for environment assets (default: environments).
ENVIRONMENTS_BUCKET=PLACEHOLDER
# Modal reconstruction web endpoint + proxy-auth token (self-host Gaussian-splat
# backend, ADR-0005). The endpoint wraps services/reconstruction/modal_app.py's
# reconstruct(); exposing it is the Operator's M1-CAPT-02 step.
MODAL_RECONSTRUCT_URL=PLACEHOLDER
MODAL_TOKEN_ID=PLACEHOLDER
MODAL_TOKEN_SECRET=PLACEHOLDER
# Legacy name: reconstruction is self-host per ADR-0005 (Luma dropped). Retained
# as a placeholder name only; there is no Luma account.
LUMA_API_KEY=PLACEHOLDER
