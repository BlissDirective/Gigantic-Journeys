# api/ environment variable NAMES only — never real values.
# Values live only in the Operator VM's .env.local (staging) and CI secrets;
# CI fails any PR that tracks a .env* file other than this one (SECURITY_CHECKLIST §1).
INNGEST_EVENT_KEY=PLACEHOLDER
INNGEST_SIGNING_KEY=PLACEHOLDER
SUPABASE_URL=PLACEHOLDER
SUPABASE_ANON_KEY=PLACEHOLDER
# Legacy name: reconstruction is self-host / KIRI corpus-only per ADR-0005 (Luma
# dropped). Retained as a placeholder name only; there is no Luma account.
LUMA_API_KEY=PLACEHOLDER
